{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/Homepage.dc.html" },
    { "source": "/product", "destination": "/Product.dc.html" },
    { "source": "/pricing", "destination": "/Pricing.dc.html" },
    { "source": "/about", "destination": "/About.dc.html" },
    { "source": "/contact", "destination": "/Contact.dc.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
